# Copy to .env and fill in. .env is gitignored.

# Your TV's IP address (Settings > General > Network > Network Status > IP Settings)
TV_IP=192.168.1.50

# Your Immich server as the TV can reach it (LAN address + port, no trailing /api)
IMMICH_URL=http://192.168.1.20:2283

# File that holds a read-only Immich API key (see README, "Create an API key")
IMMICH_KEY_FILE=$HOME/.secrets/immich-tv-key

# Optional
# PACKAGE_ID=ImmichTzn1        # exactly 10 letters/digits; change it to install a second copy
# APP_NAME=Immich              # name shown in the TV's Apps panel
# ICON_FROM_SERVER=1           # use your Immich server's own logo (favicon.png) as the app icon
# TIZEN_DATA=$HOME/.tizen-data # where the signing certificate is kept
